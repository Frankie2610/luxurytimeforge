# Firebase Web App config — Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_LINK_DOMAIN=

# Public origin used in Firebase email invitation links.
# Local example: http://localhost:5173
# Production example: https://your-domain.com
VITE_PUBLIC_SITE_URL=

# Admin access
# Required bootstrap owner. This account can send/cancel invitations and manage roles.
VITE_OWNER_EMAIL=
# Optional legacy/bootstrap admins. New members should be invited from /admin/settings/team.
VITE_ADMIN_EMAILS=
# Optional bootstrap role map. Example: admin@example.com:admin,staff@example.com:staff
VITE_ADMIN_ROLE_MAP=

# Local demo login should stay false on Vercel/production.
VITE_ENABLE_DEMO_LOGIN=false

# PayOS — server-only, KHÔNG thêm tiền tố VITE_
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Domain production không có dấu / cuối. Ví dụ: https://timeforge.vn
PUBLIC_SITE_URL=
# Thời hạn link PayOS, từ 5 đến 60 phút
PAYOS_LINK_TTL_MINUTES=15

# Server đọc/ghi trạng thái đơn hàng và payment session trong Realtime Database
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_AUTH=
