{
  "name": "timeforge-commerce",
  "private": true,
  "version": "0.49.35-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "css:audit": "node scripts/css-audit.mjs",
    "code:audit": "node scripts/dead-code-audit.mjs",
    "audit:project": "tsc -b --pretty false && node scripts/css-audit.mjs && node scripts/dead-code-audit.mjs",
    "build:report": "tsc -b && vite build && node scripts/bundle-report.mjs",
    "firebase:rules:generate": "node scripts/generate-firebase-rules.mjs",
    "firebase:rules:deploy": "node scripts/generate-firebase-rules.mjs && node scripts/check-firebase-rules.mjs && pnpm dlx firebase-tools deploy --only database",
    "firebase:rules:check": "node scripts/check-firebase-rules.mjs",
    "firebase:rules:doctor": "node scripts/firebase-rules-doctor.mjs",
    "payos:doctor": "node scripts/payos-doctor.mjs"
  },
  "dependencies": {
