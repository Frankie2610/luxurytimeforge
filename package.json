    "firebase": "12.16.0",
    "framer-motion": "12.23.24",
    "lucide-react": "1.24.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "papaparse": "5.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.65.0",
    "react-router-dom": "7.18.1",
    "recharts": "^3.9.2",
