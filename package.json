{
  "name": "timeforge-commerce",
  "private": true,
  "version": "0.52.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "css:audit": "node scripts/css-audit.mjs",
    "code:audit": "node scripts/dead-code-audit.mjs",
    "responsive:check": "node scripts/check-responsive-grid.mjs",
    "admin:css:check": "node scripts/check-admin-css.mjs",
    "auth:session:check": "node scripts/check-auth-session.mjs",
    "content:pages:check": "node scripts/check-content-pages.mjs",
    "import:status:check": "node scripts/run-import-status-check.mjs",
    "audit:project": "tsc -b --pretty false && node scripts/check-auth-session.mjs && node scripts/check-content-pages.mjs && node scripts/check-admin-css.mjs && node scripts/css-audit.mjs && node scripts/dead-code-audit.mjs",
    "build:report": "tsc -b && vite build && node scripts/bundle-report.mjs",
    "firebase:rules:generate": "node scripts/generate-firebase-rules.mjs",
    "firebase:rules:deploy": "node scripts/generate-firebase-rules.mjs && node scripts/check-firebase-rules.mjs && node scripts/deploy-firebase-rules.mjs",
    "firebase:rules:check": "node scripts/check-firebase-rules.mjs",
    "firebase:rules:doctor": "node scripts/firebase-rules-doctor.mjs",
    "payos:doctor": "node scripts/payos-doctor.mjs",
    "v512:check": "node scripts/check-v512-critical-fixes.mjs",
    "v513:check": "node scripts/check-v513-store-identity.mjs",
    "v514:check": "node scripts/check-v514-store-fallback.mjs",
    "v520:check": "node scripts/check-v520-orders-payments.mjs",
    "v521:check": "node scripts/check-v521-ui-polish.mjs",
    "v522:check": "node scripts/check-v522-ui-refinement.mjs",
    "v523:check": "node scripts/check-v523-product-admin-fix.mjs",
    "v524:check": "node scripts/check-v524-account-print.mjs",
    "v525:check": "node scripts/check-v525-order-detail-admin.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@payos/node": "2.0.5",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "12.16.0",
    "framer-motion": "12.23.24",
    "lucide-react": "1.24.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "papaparse": "5.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.65.0",
    "react-router-dom": "7.18.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "description": "Luxury Timeforge V0.52.5: larger and clearer customer order-detail typography, smaller product imagery, green operational CTAs, polished Admin Orders, and white-on-green document/account logo treatment.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <25"
  }
}
