{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/meta?resource=sitemap"
    },
    {
      "source": "/image-sitemap.xml",
      "destination": "/api/meta?resource=image-sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/meta?resource=robots"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/meta?resource=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/meta?resource=llms-full"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/api/meta?resource=ai-catalog"
    },
    {
      "source": "/api/social-image",
      "destination": "/api/meta?resource=social-image"
    },
    {
      "source": "/google-products.xml",
      "destination": "/api/meta?resource=merchant-feed"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/dong-ho-nam",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/dong-ho-nu",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/dong-ho-duoi-5-trieu",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/dong-ho-sale",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/collections",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/watch-finder",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/blogs",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/pages/about",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/pages/warranty",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/pages/shipping",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
