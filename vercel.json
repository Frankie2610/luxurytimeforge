{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/sitemap.xml", "destination": "/api/meta?resource=sitemap"},
    {"source": "/image-sitemap.xml", "destination": "/api/meta?resource=image-sitemap"},
    {"source": "/robots.txt", "destination": "/api/meta?resource=robots"},
    {"source": "/llms.txt", "destination": "/api/meta?resource=llms"},
    {"source": "/llms-full.txt", "destination": "/api/meta?resource=llms-full"},
    {"source": "/ai-catalog.json", "destination": "/api/meta?resource=ai-catalog"},
    {"source": "/api/social-image", "destination": "/api/meta?resource=social-image"},
    {"source": "/google-products.xml", "destination": "/api/meta?resource=merchant-feed"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/admin/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/admin", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/checkout", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/account/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/account", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/order-confirmation/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/payment/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/search", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/cart", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/wishlist", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/compare", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/track-order", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]}
  ]
}
